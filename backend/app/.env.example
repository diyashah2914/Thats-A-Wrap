# AI provider (server-side only)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash

# Optional Google Cloud settings
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
# Google Cloud Storage bucket for processed scene and final-film assets.
GCS_BUCKET=

# Local/runtime storage
MEDIA_ROOT=./media

# Browser origins
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Stable service identity used by OpenTelemetry
SERVICE_NAME=thats-a-wrap-backend
SERVICE_VERSION=3.1.0-grafana-mcp
OTEL_SERVICE_NAME=thats-a-wrap-backend

# ---------------- Grafana / Tempo read access ----------------
# Dedicated read/query credential for the optional in-app telemetry preview.
# Keep this separate from the Grafana MCP service-account token.
GRAFANA_URL=https://your-stack.grafana.net
GRAFANA_OBSERVABILITY_TOKEN=
GRAFANA_TEMPO_DATASOURCE_UID=
GRAFANA_TEMPO_DATASOURCE_NAME=Tempo
GRAFANA_LIVE_WINDOW_MINUTES=30
GRAFANA_LIVE_LIMIT=8

# ---------------- Official Grafana MCP ----------------
# The ADK agent launches the official grafana/mcp-grafana server over STDIO.
# That server connects to the remote Grafana Cloud stack below.
GRAFANA_SERVICE_ACCOUNT_TOKEN=
GRAFANA_MCP_COMMAND=mcp-grafana
# The command is installed with backend requirements.
GRAFANA_ORG_ID=
# Optional JSON object of additional headers forwarded by mcp-grafana.
# GRAFANA_MCP_EXTRA_HEADERS=

# ---------------- OpenTelemetry -> Grafana Cloud ----------------
# Example endpoint: https://otlp-gateway-<zone>.grafana.net/otlp
OTEL_EXPORTER_OTLP_ENDPOINT=
# Example: Authorization=Basic%20<base64(instance_id:token)>
OTEL_EXPORTER_OTLP_HEADERS=

# Faster demo encoding (override if higher quality is preferred)
FFMPEG_PRESET=superfast
FFMPEG_CRF=21
