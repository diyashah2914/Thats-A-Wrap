{
  "title": "That's a Wrap! — Production Control Room",
  "schemaVersion": 39,
  "refresh": "5s",
  "panels": [
    {"type":"stat","title":"Jobs Started","gridPos":{"h":5,"w":6,"x":0,"y":0},"targets":[{"expr":"thatsawrap_jobs_total{state=\"started\"}","refId":"A"}]},
    {"type":"stat","title":"Jobs Completed","gridPos":{"h":5,"w":6,"x":6,"y":0},"targets":[{"expr":"thatsawrap_jobs_total{state=\"completed\"}","refId":"A"}]},
    {"type":"stat","title":"Jobs Failed","gridPos":{"h":5,"w":6,"x":12,"y":0},"targets":[{"expr":"thatsawrap_jobs_total{state=\"failed\"}","refId":"A"}]},
    {"type":"stat","title":"Processing Time (s)","gridPos":{"h":5,"w":6,"x":18,"y":0},"targets":[{"expr":"thatsawrap_processing_seconds_total","refId":"A"}]},
    {"type":"timeseries","title":"Agent Calls","gridPos":{"h":9,"w":12,"x":0,"y":5},"targets":[{"expr":"thatsawrap_agent_calls_total","legendFormat":"{{agent}}","refId":"A"}]},
    {"type":"timeseries","title":"Failures","gridPos":{"h":9,"w":12,"x":12,"y":5},"targets":[{"expr":"thatsawrap_failures_total","legendFormat":"{{type}}","refId":"A"}]}
